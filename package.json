{
  "name": "factory-city",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -b && tsc -p packages/viewer --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm build && vitest run",
    "licenses:check": "node scripts/licenses-check.mjs",
    "docs:assets": "node scripts/docs-assets.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
