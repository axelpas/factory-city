{
  "id": "typescript",
  "label": "TypeScript",
  "tier": 1,
  "grammar": "typescript",
  "extensions": [".ts", ".mts", ".cts"],
  "comment": ["comment"],
  "functions": [
    "function_declaration",
    "generator_function_declaration",
    "function_expression",
    "generator_function",
    "arrow_function",
    "method_definition"
  ],
  "branches": [
    "if_statement",
    "for_statement",
    "for_in_statement",
    "while_statement",
    "do_statement",
    "switch_case",
    "catch_clause",
    "ternary_expression"
  ],
  "logical": {
    "nodeTypes": ["binary_expression"],
    "operators": ["&&", "||", "??"]
  },
  "nesting": [
    "if_statement",
    "for_statement",
    "for_in_statement",
    "while_statement",
    "do_statement",
    "switch_statement",
    "try_statement",
    "catch_clause",
    "arrow_function",
    "function_expression"
  ],
  "nestingExceptParent": {
    "if_statement": ["else_clause"]
  },
  "imports": {
    "statements": ["import_statement", "export_statement"],
    "sourceField": "source",
    "calls": {
      "nodeType": "call_expression",
      "functionField": "function",
      "argumentsField": "arguments",
      "callees": ["require", "import"]
    }
  },
  "cohesion": {
    "wrappers": ["export_statement"],
    "functionDeclarations": ["function_declaration", "generator_function_declaration"],
    "variableDeclarations": ["lexical_declaration", "variable_declaration"],
    "functionValues": ["arrow_function", "function_expression", "generator_function"],
    "classDeclarations": ["class_declaration", "abstract_class_declaration"],
    "methods": ["method_definition", "abstract_method_signature"],
    "constructorName": "constructor",
    "fields": ["public_field_definition", "field_definition"],
    "otherDeclarations": ["type_alias_declaration", "interface_declaration", "enum_declaration"],
    "identifiers": [
      "identifier",
      "type_identifier",
      "shorthand_property_identifier",
      "shorthand_property_identifier_pattern"
    ],
    "memberExpression": "member_expression",
    "selfObject": "this",
    "barrelStatements": ["import_statement", "export_statement"],
    "minStemLength": 4
  },
  "shortcuts": [
    {
      "kind": "any",
      "type": "node",
      "nodeType": "predefined_type",
      "pattern": "^any$"
    },
    {
      "kind": "ts_ignore",
      "type": "comment",
      "pattern": "@ts-ignore"
    },
    {
      "kind": "ts_expect_error",
      "type": "comment",
      "pattern": "@ts-expect-error"
    },
    {
      "kind": "ts_nocheck",
      "type": "comment",
      "pattern": "@ts-nocheck"
    },
    {
      "kind": "lint_disable",
      "type": "comment",
      "pattern": "(eslint|tslint|oxlint|stylelint)-disable|biome-ignore"
    },
    {
      "kind": "skipped_test",
      "type": "call",
      "pattern": "^((it|test|describe)\\.skip|xit|xtest|xdescribe)$"
    },
    {
      "kind": "focused_test",
      "type": "call",
      "pattern": "^((it|test|describe)\\.only|fit|fdescribe)$"
    },
    {
      "kind": "empty_catch",
      "type": "emptyBlock",
      "nodeType": "catch_clause",
      "bodyField": "body"
    }
  ],
  "security": [
    {
      "kind": "dynamic_code",
      "type": "call",
      "pattern": "^(eval|window\\.eval|globalThis\\.eval)$"
    },
    {
      "kind": "dynamic_code",
      "type": "node",
      "nodeType": "new_expression",
      "pattern": "^new\\s+Function\\s*\\("
    },
    {
      "kind": "command_exec",
      "type": "call",
      "pattern": "^(child_process\\.|cp\\.|childProcess\\.)?(exec|execSync)$"
    },
    {
      "kind": "command_exec",
      "type": "node",
      "nodeType": "pair",
      "pattern": "^shell\\s*:\\s*true$"
    },
    {
      "kind": "unsafe_html",
      "type": "node",
      "nodeType": "assignment_expression",
      "pattern": "\\.(innerHTML|outerHTML)\\s*\\+?="
    },
    {
      "kind": "unsafe_html",
      "type": "node",
      "nodeType": "jsx_attribute",
      "pattern": "^dangerouslySetInnerHTML"
    },
    {
      "kind": "unsafe_html",
      "type": "call",
      "pattern": "^document\\.write(ln)?$"
    },
    {
      "kind": "hardcoded_secret",
      "type": "node",
      "nodeType": "variable_declarator",
      "pattern": "([pP]ass(word|wd)|PASS(WORD|WD)|[sS]ecret|SECRET|[tT]oken|TOKEN|[aA]pi[_-]?[kK]ey|API_?KEY)\\w*\\s*(:\\s*\\w+\\s*)?=\\s*[\"'`][^\"'`\\s$]{8,}[\"'`]$"
    },
    {
      "kind": "hardcoded_secret",
      "type": "node",
      "nodeType": "pair",
      "pattern": "^[\"']?([pP]ass(word|wd)|PASS(WORD|WD)|[sS]ecret|SECRET|[tT]oken|TOKEN|[aA]pi[_-]?[kK]ey|API_?KEY)\\w*[\"']?\\s*:\\s*[\"'`][^\"'`\\s$]{8,}[\"'`]$"
    },
    {
      "kind": "hardcoded_secret",
      "type": "node",
      "nodeType": "string",
      "pattern": "^[\"'](ghp_[A-Za-z0-9]{30,}|github_pat_\\w{20,}|sk-[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[\\w-]{10,})"
    },
    {
      "kind": "hardcoded_secret",
      "type": "node",
      "nodeType": "string",
      "pattern": "BEGIN (RSA |EC |OPENSSH |DSA )?PRIVATE KEY"
    },
    {
      "kind": "hardcoded_secret",
      "type": "node",
      "nodeType": "template_string",
      "pattern": "BEGIN (RSA |EC |OPENSSH |DSA )?PRIVATE KEY"
    },
    {
      "kind": "tls_disabled",
      "type": "node",
      "nodeType": "pair",
      "pattern": "^rejectUnauthorized\\s*:\\s*false$"
    },
    {
      "kind": "tls_disabled",
      "type": "node",
      "nodeType": "assignment_expression",
      "pattern": "NODE_TLS_REJECT_UNAUTHORIZED[\"'\\]]*\\s*=\\s*[\"']?0"
    },
    {
      "kind": "sql_concat",
      "type": "node",
      "nodeType": "call_expression",
      "pattern": "(^|\\.)(query|execute|raw|queryRawUnsafe|executeRawUnsafe)\\(\\s*(`[^`]*\\$\\{|\"[^\"]*\"\\s*\\+|'[^']*'\\s*\\+)"
    }
  ]
}
