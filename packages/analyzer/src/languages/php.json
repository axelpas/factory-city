{
  "id": "php",
  "label": "PHP",
  "tier": 2,
  "grammar": "php",
  "extensions": [".php"],
  "comment": ["comment"],
  "functions": ["function_definition", "method_declaration", "anonymous_function", "arrow_function"],
  "branches": [
    "if_statement",
    "else_if_clause",
    "for_statement",
    "foreach_statement",
    "while_statement",
    "do_statement",
    "case_statement",
    "catch_clause",
    "conditional_expression",
    "match_conditional_expression"
  ],
  "logical": {
    "nodeTypes": ["binary_expression"],
    "operators": ["&&", "||", "??", "and", "or"]
  },
  "nesting": [
    "if_statement",
    "for_statement",
    "foreach_statement",
    "while_statement",
    "do_statement",
    "switch_statement",
    "try_statement",
    "match_expression",
    "anonymous_function",
    "arrow_function"
  ],
  "nestingExceptParent": {
    "if_statement": ["else_clause"]
  },
  "shortcuts": [
    {
      "kind": "lint_disable",
      "type": "comment",
      "pattern": "phpcs:(ignore|disable)|@phpstan-ignore|@psalm-suppress|@codeCoverageIgnore"
    },
    {
      "kind": "empty_catch",
      "type": "emptyBlock",
      "nodeType": "catch_clause",
      "bodyField": "body"
    }
  ]
}
