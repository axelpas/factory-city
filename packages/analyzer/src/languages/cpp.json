{
  "id": "cpp",
  "label": "C++",
  "tier": 1,
  "grammar": "cpp",
  "extensions": [".cpp", ".cc", ".cxx", ".hpp", ".hh", ".hxx"],
  "comment": ["comment"],
  "functions": ["function_definition", "lambda_expression"],
  "branches": [
    "if_statement",
    "for_statement",
    "while_statement",
    "do_statement",
    "case_statement",
    "conditional_expression",
    "for_range_loop",
    "catch_clause"
  ],
  "logical": {
    "nodeTypes": ["binary_expression"],
    "operators": ["&&", "||"]
  },
  "nesting": [
    "if_statement",
    "for_statement",
    "while_statement",
    "do_statement",
    "switch_statement",
    "for_range_loop",
    "try_statement",
    "lambda_expression"
  ],
  "nestingExceptParent": {
    "if_statement": ["else_clause"]
  },
  "shortcuts": [
    {
      "kind": "lint_disable",
      "type": "comment",
      "pattern": "NOLINT|cppcheck-suppress|NOSONAR|coverity\\[|flawfinder"
    },
    {
      "kind": "lint_disable",
      "type": "node",
      "nodeType": "preproc_call",
      "pattern": "^#\\s*pragma\\s+((GCC|clang)\\s+diagnostic\\s+ignored|warning\\s*\\(\\s*disable)"
    },
    {
      "kind": "skipped_test",
      "type": "call",
      "nodeType": "call_expression",
      "pattern": "^(TEST|TEST_F|TEST_P|TYPED_TEST)$",
      "argsPattern": "DISABLED_"
    },
    {
      "kind": "skipped_test",
      "type": "call",
      "nodeType": "call_expression",
      "pattern": "^(GTEST_SKIP|SKIP|GTEST_SKIP_)$"
    },
    {
      "kind": "empty_catch",
      "type": "emptyBlock",
      "nodeType": "catch_clause",
      "bodyField": "body"
    }
  ],
  "modules": {
    "statements": [
      {
        "nodeType": "preproc_include",
        "moduleField": "",
        "moduleType": "string_literal",
        "specPrefix": "q:"
      },
      {
        "nodeType": "preproc_include",
        "moduleField": "",
        "moduleType": "system_lib_string",
        "specPrefix": "s:"
      }
    ],
    "resolver": "c"
  },
  "cohesion": {
    "wrappers": ["template_declaration"],
    "functionDeclarations": ["function_definition"],
    "variableDeclarations": [],
    "functionValues": [],
    "classDeclarations": ["class_specifier", "struct_specifier"],
    "methods": ["function_definition"],
    "constructorName": "",
    "fields": ["field_declaration"],
    "nameFromDeclarator": true,
    "declaratorDeclarations": ["declaration", "type_definition"],
    "otherDeclarations": ["enum_specifier", "union_specifier"],
    "identifiers": ["identifier", "type_identifier"],
    "memberExpression": "field_expression",
    "memberObjectField": "argument",
    "memberPropertyField": "field",
    "selfObject": "this",
    "barrelStatements": ["preproc_include", "preproc_def", "preproc_ifdef", "preproc_if"],
    "minStemLength": 4,
    "wrapperField": "",
    "containers": ["namespace_definition"],
    "bareMembers": true
  },
  "security": [
    {
      "kind": "dynamic_code",
      "type": "call",
      "nodeType": "call_expression",
      "pattern": "^(dlopen|LoadLibrary[AW]?)$"
    },
    {
      "kind": "command_exec",
      "type": "call",
      "nodeType": "call_expression",
      "pattern": "(^|::)(system|popen|_popen|execl|execlp|execle|execv|execvp|execve|WinExec|ShellExecute[AW]?)$"
    },
    {
      "kind": "unsafe_function",
      "type": "call",
      "nodeType": "call_expression",
      "pattern": "(^|::)(gets|strcpy|strcat|sprintf|vsprintf|stpcpy|wcscpy|wcscat|tmpnam|tempnam|mktemp)$"
    },
    {
      "kind": "hardcoded_secret",
      "type": "node",
      "nodeType": "init_declarator",
      "pattern": "^\\**\\s*\\w*([pP]ass(word|wd)|PASS(WORD|WD)|[sS]ecret|SECRET|[tT]oken|TOKEN|[aA][pP][iI][_-]?[kK][eE][yY])\\w*(\\[\\])?\\s*=\\s*\"(?![a-z_]+\")(?![A-Z_]+\")(?!\\S*/)[^\"\\s${}%]{8,}\"$"
    },
    {
      "kind": "hardcoded_secret",
      "type": "node",
      "nodeType": "assignment_expression",
      "pattern": "^[\\w.>-]*\\w*([pP]ass(word|wd)|PASS(WORD|WD)|[sS]ecret|SECRET|[tT]oken|TOKEN|[aA][pP][iI][_-]?[kK][eE][yY])\\w*\\s*=\\s*\"(?![a-z_]+\")(?![A-Z_]+\")(?!\\S*/)[^\"\\s${}%]{8,}\"$"
    },
    {
      "kind": "hardcoded_secret",
      "type": "node",
      "nodeType": "preproc_def",
      "pattern": "^#\\s*define\\s+\\w*([pP]ass(word|wd)|PASS(WORD|WD)|[sS]ecret|SECRET|[tT]oken|TOKEN|[aA][pP][iI][_-]?[kK][eE][yY])\\w*\\s+\"(?![a-z_]+\")(?![A-Z_]+\")(?!\\S*/)[^\"\\s${}%]{8,}\"\\s*$"
    },
    {
      "kind": "hardcoded_secret",
      "type": "node",
      "nodeType": "string_literal",
      "pattern": "^\"(ghp_[A-Za-z0-9]{30,}|github_pat_\\w{20,}|sk-[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[\\w-]{10,})"
    },
    {
      "kind": "hardcoded_secret",
      "type": "node",
      "nodeType": "string_literal",
      "pattern": "BEGIN (RSA |EC |OPENSSH |DSA )?PRIVATE KEY"
    },
    {
      "kind": "hardcoded_secret",
      "type": "node",
      "nodeType": "raw_string_literal",
      "pattern": "BEGIN (RSA |EC |OPENSSH |DSA )?PRIVATE KEY"
    },
    {
      "kind": "tls_disabled",
      "type": "call",
      "nodeType": "call_expression",
      "pattern": "^SSL_(CTX_)?set_verify$",
      "argsPattern": "SSL_VERIFY_NONE"
    },
    {
      "kind": "tls_disabled",
      "type": "call",
      "nodeType": "call_expression",
      "pattern": "^curl_easy_setopt$",
      "argsPattern": "CURLOPT_SSL_VERIFY(PEER|HOST)\\s*,\\s*0"
    },
    {
      "kind": "sql_concat",
      "type": "call",
      "nodeType": "call_expression",
      "pattern": "^(sprintf|snprintf)$",
      "argsPattern": "\"\\s*([Ss][Ee][Ll][Ee][Cc][Tt]|[Ii][Nn][Ss][Ee][Rr][Tt]|[Uu][Pp][Dd][Aa][Tt][Ee]|[Dd][Ee][Ll][Ee][Tt][Ee])\\b[^\"]*%"
    }
  ]
}
